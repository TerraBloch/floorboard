# Floorboard environment variables.
# Copy to .env.local for development. NEVER commit a real key.

# Required: Unisat API bearer token (get one at developer.unisat.io).
UNISAT_API_KEY=

# Optional: override the User-Agent the Unisat client sends. Defaults to
# floorboard/0.0 with the repo URL. Useful for production deployments to
# include a contact email per Unisat's TOS.
# FLOORBOARD_USER_AGENT=floorboard/0.0 (contact@example.com)
